# Required: create an API key in the Anthropic Console
ANTHROPIC_API_KEY=replace_me

# Optional: check Anthropic Console for the model available to your account
CLAUDE_MODEL=claude-sonnet-5

# Number of server-side web searches Claude may perform per daily run.
# More searches may improve coverage but increase cost.
MAX_SEARCHES=12

# Optional email delivery (e.g. SMTP provider/app password).
# If omitted, GitHub Actions stores the Markdown report as an artifact.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=
EMAIL_TO=
